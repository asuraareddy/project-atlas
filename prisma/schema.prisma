// Project Atlas — PostgreSQL Schema (09_DATA_MODEL.md & 21_CRYPTO_QR_DEPOSITS.md)
// Multi-Gaming PWA with Double-Entry Ledger, RBAC & Direct Crypto QR Deposits

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Organization & Tenancy
// -------------------------------------------------------------

model Organization {
  id              String         @id @default(uuid())
  name            String
  slug            String?        @unique
  status          String         @default("ACTIVE") // ACTIVE, SUSPENDED
  packageCode     String?        @default("COMPLETE_PRO_SUITE") @map("package_code")
  branding        Json?
  defaultCurrency String         @default("GBP") @map("default_currency")
  timezone        String         @default("Europe/London")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  branches        Branch[]
  users           User[]
  roles           Role[]
  games           Game[]
  gameProviders   GameProvider[]
  ledgerAccounts  LedgerAccount[]
  ledgerTxs       LedgerTransaction[]
  auditEvents     AuditEvent[]
  domains         TenantDomain[]
  entitlements    TenantGameEntitlementRecord[]

  @@map("organizations")
}

model TenantDomain {
  id                 String       @id @default(uuid())
  organizationId     String       @map("organization_id")
  hostname           String       @unique
  isPrimary          Boolean      @default(false) @map("is_primary")
  verificationStatus String       @default("VERIFIED") @map("verification_status")
  verificationToken  String       @map("verification_token")
  sslStatus          String       @default("ACTIVE") @map("ssl_status")
  createdAt          DateTime     @default(now()) @map("created_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("tenant_domains")
}

model TenantGameEntitlementRecord {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  gameKey        String       @map("game_key")
  isEnabled      Boolean      @default(true) @map("is_enabled")
  displayOrder   Int          @default(1) @map("display_order")
  customTitle    String?      @map("custom_title")
  customBadge    String?      @map("custom_badge")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, gameKey])
  @@map("tenant_game_entitlements")
}


model Branch {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  code           String       @unique
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]

  @@map("branches")
}

// -------------------------------------------------------------
// Identity, RBAC & Profiles
// -------------------------------------------------------------

enum AccountType {
  PLAYER
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  EXCLUDED
  LOCKED
}

model User {
  id                   String        @id @default(uuid())
  organizationId       String        @map("organization_id")
  branchId             String?       @map("branch_id")
  emailNormalized      String        @unique @map("email_normalized")
  phoneNormalized      String?       @map("phone_normalized")
  passwordHashOrIdpRef String        @map("password_hash_or_idp_ref")
  accountType          AccountType   @default(PLAYER) @map("account_type")
  status               UserStatus    @default(ACTIVE)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  organization         Organization  @relation(fields: [organizationId], references: [id])
  branch               Branch?       @relation(fields: [branchId], references: [id])
  playerProfile        PlayerProfile?
  staffProfile         StaffProfile?
  roleAssignments      UserRoleAssignment[]
  sessions             Session[]
  wallets              Wallet[]
  depositIntents       CryptoDepositIntent[]
  withdrawalRequests   WithdrawalRequest[]
  gameSessions         GameSession[]
  gameParticipations   GameParticipation[]
  restrictions         AccountRestriction[]
  complianceCases      ComplianceCase[]

  @@index([organizationId, branchId])
  @@map("users")
}

model PlayerProfile {
  userId             String   @id @map("user_id")
  displayName        String   @map("display_name")
  dateOfBirthRef     String?  @map("date_of_birth_ref")
  kycStatus          String   @default("UNVERIFIED") @map("kyc_status") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  country            String   @default("GB")
  contactPreferences Json?    @map("contact_preferences")
  createdAt          DateTime @default(now()) @map("created_at")

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_profiles")
}

model StaffProfile {
  userId      String    @id @map("user_id")
  staffCode   String    @unique @map("staff_code")
  department  String
  activeFrom  DateTime  @default(now()) @map("active_from")
  activeUntil DateTime? @map("active_until")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model Role {
  id             String               @id @default(uuid())
  organizationId String?              @map("organization_id")
  roleKey        String               @unique @map("role_key")
  label          String
  isSystemRole   Boolean              @default(true) @map("is_system_role")

  organization   Organization?        @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]
  assignments    UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id            String           @id @default(uuid())
  permissionKey String           @unique @map("permission_key")
  description   String

  roles         RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  scopeType String    @default("GLOBAL") @map("scope_type") // GLOBAL, ORGANIZATION, BRANCH
  scopeId   String?   @map("scope_id")
  grantedBy String    @map("granted_by")
  startsAt  DateTime  @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId, roleId])
  @@map("user_role_assignments")
}

model Session {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  deviceHint         String?   @map("device_hint")
  ipHashOrMinimised  String?   @map("ip_hash_or_minimised")
  createdAt          DateTime  @default(now()) @map("created_at")
  expiresAt          DateTime  @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

// -------------------------------------------------------------
// Compliance & Safer Gambling
// -------------------------------------------------------------

model AccountRestriction {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  restrictionType String    @map("restriction_type") // DEPOSIT_LIMIT, SELF_EXCLUSION, TIME_OUT, GAMING_BLOCK
  scope           String    @default("ALL")
  startsAt        DateTime  @default(now()) @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  reasonCode      String    @map("reason_code")
  createdBy       String    @map("created_by")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, restrictionType])
  @@map("account_restrictions")
}

model ComplianceCase {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  caseType   String    @map("case_type") // AML, SOURCE_OF_FUNDS, SAFER_GAMBLING
  priority   String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status     String    @default("OPEN")   // OPEN, UNDER_REVIEW, RESOLVED, CLOSED
  assignedTo String?   @map("assigned_to")
  openedAt   DateTime  @default(now()) @map("opened_at")
  closedAt   DateTime? @map("closed_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("compliance_cases")
}

// -------------------------------------------------------------
// Double-Entry Ledger & Wallets
// -------------------------------------------------------------

enum WalletType {
  PLAYER_PRIMARY
  OPERATOR_SYSTEM
}

model Wallet {
  id                  String     @id @default(uuid())
  userId              String     @map("user_id")
  walletType          WalletType @default(PLAYER_PRIMARY) @map("wallet_type")
  currency            String     @default("GBP")
  cashAvailableMinor  BigInt     @default(0) @map("cash_available_minor")
  cashReservedMinor   BigInt     @default(0) @map("cash_reserved_minor")
  bonusMinor          BigInt     @default(0) @map("bonus_minor")
  pointsBalance       BigInt     @default(0) @map("points_balance")
  status              String     @default("ACTIVE")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency])
  @@map("wallets")
}

model LedgerAccount {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  accountCode    String         @unique @map("account_code")
  accountType    String         @map("account_type") // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  currency       String         @default("GBP")
  status         String         @default("ACTIVE")

  organization   Organization   @relation(fields: [organizationId], references: [id])
  entries        LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  sourceType     String         @map("source_type") // CRYPTO_DEPOSIT, WITHDRAWAL, GAME_STAKE, GAME_WIN, BONUS_GRANT
  sourceId       String         @map("source_id")
  idempotencyKey String         @unique @map("idempotency_key")
  status         String         @default("POSTED") // POSTED, REVERSED
  reasonCode     String         @map("reason_code")
  actorId        String?        @map("actor_id")
  correlationId  String         @map("correlation_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  organization   Organization   @relation(fields: [organizationId], references: [id])
  entries        LedgerEntry[]

  @@index([sourceType, sourceId])
  @@map("ledger_transactions")
}

enum EntryDirection {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id              String            @id @default(uuid())
  transactionId   String            @map("transaction_id")
  ledgerAccountId String            @map("ledger_account_id")
  direction       EntryDirection
  amountMinor     BigInt            @map("amount_minor") // Integer GBP pence
  currency        String            @default("GBP")
  createdAt       DateTime          @default(now()) @map("created_at")

  transaction     LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount     @relation(fields: [ledgerAccountId], references: [id])

  @@index([transactionId])
  @@index([ledgerAccountId])
  @@map("ledger_entries")
}

// -------------------------------------------------------------
// Direct Crypto QR Deposits (No PSP) & Withdrawals
// -------------------------------------------------------------

enum CryptoIntentStatus {
  PENDING
  DETECTED
  CONFIRMING
  COMPLETED
  EXPIRED
  FAILED
  RISK_HOLD
}

model CryptoDepositIntent {
  id                     String             @id @default(uuid())
  userId                 String             @map("user_id")
  asset                  String             // USDT, USDC, BTC, ETH
  network                String             // polygon, ethereum, bitcoin, bsc
  receivingAddress       String             @map("receiving_address")
  expectedAmountCrypto   Decimal            @map("expected_amount_crypto") @db.Decimal(36, 18)
  quotedRateGbp          Decimal            @map("quoted_rate_gbp") @db.Decimal(18, 6)
  creditedGbpMinor       BigInt             @map("credited_gbp_minor")
  qrPayload              String             @map("qr_payload")
  status                 CryptoIntentStatus @default(PENDING)
  txHash                 String?            @map("tx_hash")
  observedConfirmations  Int                @default(0) @map("observed_confirmations")
  requiredConfirmations  Int                @default(12) @map("required_confirmations")
  idempotencyKey         String             @unique @map("idempotency_key")
  expiresAt              DateTime           @map("expires_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  user                   User               @relation(fields: [userId], references: [id])

  @@index([status, receivingAddress])
  @@index([txHash])
  @@map("crypto_deposit_intents")
}

enum WithdrawalStatus {
  REQUESTED
  RISK_HOLD
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

model WithdrawalRequest {
  id                   String           @id @default(uuid())
  userId               String           @map("user_id")
  amountMinor          BigInt           @map("amount_minor")
  currency             String           @default("GBP")
  destinationType      String           @map("destination_type") // UK_BANK_BACS, DIRECT_CRYPTO
  destinationReference String           @map("destination_reference")
  status               WithdrawalStatus @default(REQUESTED)
  makerId              String?          @map("maker_id")
  checkerId            String?          @map("checker_id")
  riskScore            Int              @default(0) @map("risk_score")
  createdAt            DateTime         @default(now()) @map("created_at")
  decidedAt            DateTime?        @map("decided_at")

  user                 User             @relation(fields: [userId], references: [id])

  @@index([status])
  @@map("withdrawal_requests")
}

// -------------------------------------------------------------
// Games, Providers, Rounds & Settlements
// -------------------------------------------------------------

model GameProvider {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  name            String
  slug            String       @unique
  status          String       @default("ACTIVE")
  integrationType String       @default("CLIENT_MATKA_API") @map("integration_type")
  createdAt       DateTime     @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id])
  games           Game[]

  @@map("game_providers")
}

model Game {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  providerId       String        @map("provider_id")
  slug             String        @unique
  name             String
  category         String        // MATKA, CARROM, LUDO, OTHER_GAMES
  status           String        @default("ACTIVE")
  realMoneyEnabled Boolean       @default(false) @map("real_money_enabled")
  createdAt        DateTime      @default(now()) @map("created_at")

  organization     Organization  @relation(fields: [organizationId], references: [id])
  provider         GameProvider  @relation(fields: [providerId], references: [id])
  sessions         GameSession[]

  @@index([category, status])
  @@map("games")
}

model GameSession {
  id                 String              @id @default(uuid())
  gameId             String              @map("game_id")
  userId             String              @map("user_id")
  providerSessionRef String              @map("provider_session_ref")
  status             String              @default("ACTIVE")
  startedAt          DateTime            @default(now()) @map("started_at")
  endedAt            DateTime?           @map("ended_at")

  game               Game                @relation(fields: [gameId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  participations     GameParticipation[]

  @@map("game_sessions")
}

model GameParticipation {
  id             String      @id @default(uuid())
  gameSessionId  String      @map("game_session_id")
  userId         String      @map("user_id")
  roundId        String      @map("round_id")
  stakeMinor     BigInt      @map("stake_minor")
  payoutMinor    BigInt      @default(0) @map("payout_minor")
  currency       String      @default("GBP")
  idempotencyKey String      @unique @map("idempotency_key")
  status         String      @default("CONFIRMED")
  createdAt      DateTime    @default(now()) @map("created_at")

  session        GameSession @relation(fields: [gameSessionId], references: [id])
  user           User        @relation(fields: [userId], references: [id])

  @@index([roundId])
  @@map("game_participations")
}

// -------------------------------------------------------------
// Admin Maker-Checker Dual Approval & Auditing
// -------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id                   String         @id @default(uuid())
  actionType           String         @map("action_type") // WITHDRAWAL_PAYOUT, GAME_RESULT_OVERRIDE, SYSTEM_KILLSWITCH, BALANCE_ADJUSTMENT
  resourceType         String         @map("resource_type")
  resourceId           String         @map("resource_id")
  requestedBy          String         @map("requested_by") // Maker ID
  requestedPayloadHash String         @map("requested_payload_hash")
  status               ApprovalStatus @default(PENDING)
  approvedBy           String?        @map("approved_by") // Checker ID (Must !== Maker ID)
  reason               String
  createdAt            DateTime       @default(now()) @map("created_at")
  decidedAt            DateTime?      @map("decided_at")

  @@index([status, actionType])
  @@map("approval_requests")
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  actorType      String       @map("actor_type") // USER, STAFF, SYSTEM
  actorId        String       @map("actor_id")
  action         String
  resourceType   String       @map("resource_type")
  resourceId     String       @map("resource_id")
  reason         String?
  ipHint         String?      @map("ip_hint")
  correlationId  String       @map("correlation_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_events")
}


// -------------------------------------------------------------
// B2B White-Label Multi-Tenant SaaS & Plug-and-Play Addon Marketplace
// (Section 8: Database Architecture)
// -------------------------------------------------------------

model TenantProfile {
  id              String         @id @default(uuid())
  slug            String         @unique
  businessName    String         @map("business_name")
  brandName       String         @map("brand_name")
  status          String         @default("ACTIVE") // ACTIVE, SUSPENDED, ONBOARDING, ARCHIVED
  packageCode     String         @default("COMPLETE_PRO_SUITE") @map("package_code")
  contactEmail    String         @map("contact_email")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  branding        TenantBrandingConfigRecord?
  domains         TenantCustomDomain[]
  tenantUsers     TenantUserRecord[]
  tenantRoles     TenantRoleRecord[]
  addons          TenantAddonEntitlement[]
  providerConfigs TenantProviderCredential[]
  subscriptions   TenantSubscriptionRecord[]
  entitlements    TenantFeatureEntitlement[]
  usageRecords    TenantUsageMetric[]
  auditLogs       TenantAuditRecord[]

  @@map("tenants")
}

model TenantCustomDomain {
  id                 String        @id @default(uuid())
  tenantId           String        @map("tenant_id")
  hostname           String        @unique
  isPrimary          Boolean       @default(false) @map("is_primary")
  verificationStatus String        @default("VERIFIED") @map("verification_status") // VERIFIED, PENDING_DNS, FAILED
  verificationToken  String        @map("verification_token")
  sslStatus          String        @default("ACTIVE") @map("ssl_status") // ACTIVE, PENDING, ERROR
  verifiedAt         DateTime?     @map("verified_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  tenant             TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_domains_v2")
}

model TenantBrandingConfigRecord {
  id                String        @id @default(uuid())
  tenantId          String        @unique @map("tenant_id")
  brandName         String        @map("brand_name")
  tagline           String?
  logoUrl           String        @default("/icons/icon-192.png") @map("logo_url")
  faviconUrl        String?       @default("/favicon.ico") @map("favicon_url")
  primaryColor      String        @default("#7e0ac2") @map("primary_color")
  primaryColorHover String        @default("#9a13e6") @map("primary_color_hover")
  secondaryColor    String        @default("#b45df0") @map("secondary_color")
  backgroundColor   String        @default("#18181b") @map("background_color")
  textColor         String        @default("#ffffff") @map("text_color")
  accentGlowColor   String        @default("rgba(126,10,194,0.35)") @map("accent_glow_color")
  heroHeading       String        @map("hero_heading")
  heroSubheading    String        @map("hero_subheading")
  footerText        String        @map("footer_text")
  supportEmail      String        @map("support_email")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  tenant            TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

model TenantUserRecord {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  userId      String        @map("user_id")
  email       String
  role        String        @default("PLAYER") // CLIENT_ADMIN, OPERATOR_STAFF, PLAYER
  status      String        @default("ACTIVE")
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant      TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, email])
  @@map("tenant_users")
}

model TenantRoleRecord {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  roleKey     String        @map("role_key")
  roleName    String        @map("role_name")
  permissions Json          @default("[]") // array of permission strings
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant      TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleKey])
  @@map("tenant_roles")
}

model AddonRegistryRecord {
  id                   String                 @id // e.g. 'sports', 'casino'
  name                 String
  version              String                 @default("1.0.0")
  category             String                 // SPORTS, CASINO, SKILL_GAMES, etc.
  status               String                 @default("ACTIVE") // ACTIVE, INACTIVE, BETA
  description          String
  iconName             String                 @map("icon_name")
  routePrefix          String                 @map("route_prefix")
  routes               Json                   @default("[]")
  requiredPermissions  Json                   @default("[]") @map("required_permissions")
  dependentServices    Json                   @default("[]") @map("dependent_services")
  configurationSchema  Json                   @default("{}") @map("configuration_schema")
  healthCheckEndpoint  String                 @map("health_check_endpoint")
  providerRequirements Json                   @default("[]") @map("provider_requirements")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  versions             AddonVersionRecord[]
  dependencies         AddonDependencyRecord[]
  tenantAddons         TenantAddonEntitlement[]

  @@map("addon_registry")
}

model AddonVersionRecord {
  id             String              @id @default(uuid())
  addonId        String              @map("addon_id")
  version        String
  changelog      String?
  releaseStatus  String              @default("STABLE") @map("release_status") // STABLE, DEPRECATED, BETA
  releasedAt     DateTime            @default(now()) @map("released_at")

  addon          AddonRegistryRecord @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([addonId, version])
  @@map("addon_versions")
}

model AddonDependencyRecord {
  id                 String              @id @default(uuid())
  addonId            String              @map("addon_id")
  dependentServiceId String              @map("dependent_service_id")
  isRequired         Boolean             @default(true) @map("is_required")
  minimumVersion     String?             @map("minimum_version")

  addon              AddonRegistryRecord @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([addonId, dependentServiceId])
  @@map("addon_dependencies")
}

model TenantAddonEntitlement {
  id           String              @id @default(uuid())
  tenantId     String              @map("tenant_id")
  addonId      String              @map("addon_id")
  isEnabled    Boolean             @default(true) @map("is_enabled")
  displayOrder Int                 @default(1) @map("display_order")
  version      String              @default("1.0.0")
  customConfig Json?               @map("custom_config")
  activatedAt  DateTime            @default(now()) @map("activated_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  tenant       TenantProfile       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addon        AddonRegistryRecord @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([tenantId, addonId])
  @@map("tenant_addons")
}

model ProviderRegistryRecord {
  id                   String                      @id // e.g. 'prov_betfair_api_ng', 'prov_flexrix_casino_api'
  name                 String
  category             String                      // SPORTS_EXCHANGE, CASINO_AGGREGATOR, CRYPTO_GATEWAY
  status               String                      @default("ACTIVE")
  adapterClass         String                      @map("adapter_class")
  credentialSchema     Json                        @default("{}") @map("credential_schema")
  createdAt            DateTime                    @default(now()) @map("created_at")

  tenantConfigs        TenantProviderCredential[]
  healthRecords        IntegrationHealthRecord[]

  @@map("provider_registry")
}

model TenantProviderCredential {
  id                   String                 @id @default(uuid())
  tenantId             String                 @map("tenant_id")
  providerId           String                 @map("provider_id")
  isLive               Boolean                @default(false) @map("is_live") // false = SANDBOX / TEST MODE
  encryptedCredentials Json                   @map("encrypted_credentials")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  tenant               TenantProfile          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider             ProviderRegistryRecord @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerId])
  @@map("tenant_provider_config")
}

model TenantSubscriptionRecord {
  id                 String        @id @default(uuid())
  tenantId           String        @map("tenant_id")
  packageCode        String        @map("package_code")
  billingCycle       String        @default("MONTHLY") @map("billing_cycle") // MONTHLY, ANNUAL
  monthlyPriceMinor  Int           @map("monthly_price_minor")
  currency           String        @default("GBP")
  status             String        @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  currentPeriodStart DateTime      @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime      @map("current_period_end")
  createdAt          DateTime      @default(now()) @map("created_at")

  tenant             TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_subscriptions")
}

model TenantFeatureEntitlement {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  featureKey     String        @map("feature_key")
  isEntitled     Boolean       @default(true) @map("is_entitled")
  quotaLimit     Int?          @map("quota_limit")
  currentUsage   Int           @default(0) @map("current_usage")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant         TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@map("tenant_entitlements")
}

model TenantAuditRecord {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  actorId       String        @map("actor_id")
  actorRole     String        @map("actor_role")
  action        String
  resourceType  String        @map("resource_type")
  resourceId    String        @map("resource_id")
  metadata      Json?
  ipAddress     String?       @map("ip_address")
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant        TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model TenantUsageMetric {
  id                 String        @id @default(uuid())
  tenantId           String        @map("tenant_id")
  metricDate         DateTime      @default(now()) @map("metric_date")
  activeUsersCount   Int           @default(0) @map("active_users_count")
  totalTurnoverMinor BigInt        @default(0) @map("total_turnover_minor")
  ggrMinor           BigInt        @default(0) @map("ggr_minor")
  apiCallsCount      Int           @default(0) @map("api_calls_count")

  tenant             TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metricDate])
  @@map("tenant_usage")
}

model IntegrationHealthRecord {
  id              String                 @id @default(uuid())
  providerId      String                 @map("provider_id")
  endpointChecked String                 @map("endpoint_checked")
  status          String                 @default("HEALTHY") // HEALTHY, DEGRADED, DOWN
  latencyMs       Int                    @map("latency_ms")
  checkedAt       DateTime               @default(now()) @map("checked_at")
  details         Json?

  provider        ProviderRegistryRecord @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, checkedAt])
  @@map("integration_health")
}
