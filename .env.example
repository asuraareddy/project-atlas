# ===================================================
# Project Atlas — Environment Configuration Template
# ===================================================

# Platform & Deployment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="Project Atlas"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PLATFORM_ORGANIZATION_ID="org_atlas_uk_001"
DEFAULT_CURRENCY="GBP"

# Authentication & Session Security
JWT_SECRET="atlas_super_secure_jwt_secret_min_32_characters_random_token_key"
SESSION_COOKIE_NAME="atlas_session"
ADMIN_SESSION_COOKIE_NAME="atlas_admin_session"
CSRF_SECRET="atlas_csrf_secret_random_token"

# Database (PostgreSQL)
DATABASE_URL="postgresql://atlas_user:atlas_password@localhost:5432/atlas_gaming_db?schema=public"

# Redis Cache & Realtime Presence
REDIS_URL="redis://localhost:6379"

# Feature Flags (All real-money capabilities default OFF)
ENABLE_REAL_MONEY_GAMBLING=false
ENABLE_CRYPTO_DEPOSITS=false
ENABLE_LIVE_MATKA_PROVIDER=false
ENABLE_LIVE_LUDO_PROVIDER=false
ENABLE_LIVE_CARROM_PROVIDER=false
ENABLE_LIVE_POOL_PROVIDER=false

# Direct Crypto QR Deposit Configuration
CRYPTO_PRICE_FEED_PROVIDER="mock_coingecko"
POLYGON_RPC_URL="https://rpc-amoy.polygon.technology"
ETHEREUM_SEPOLIA_RPC_URL="https://rpc.sepolia.org"
BITCOIN_TESTNET_RPC_URL="http://testnet.bitcoin.invalid"

# Maker-Checker Policy
WITHDRAWAL_MAKER_CHECKER_THRESHOLD_PENCE=10000 # £100.00
ADJUSTMENT_MAKER_CHECKER_THRESHOLD_PENCE=1000   # £10.00

# Client Matka API (matkaapi.com)
MATKA_API_URL="https://www.matkaapi.com/mapi"
MATKA_DOMAIN_KEY="your_trial_or_production_domain_key"
MATKA_DOMAIN="your_registered_domain.com"

LUDO_PROVIDER_API_BASE_URL="https://api.sandbox-ludo.example.com/v1"
LUDO_PROVIDER_API_KEY=""

CARROM_PROVIDER_API_BASE_URL="https://api.sandbox-carrom.example.com/v1"
CARROM_PROVIDER_API_KEY=""

POOL_PROVIDER_API_BASE_URL="https://api.sandbox-pool.example.com/v1"
POOL_PROVIDER_API_KEY=""
